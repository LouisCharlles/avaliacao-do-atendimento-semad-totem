# Copie para .env antes de gerar o APK. Valores EXPO_PUBLIC_* são embutidos no app no build.
# Endereço do servidor (nginx do docker-compose). Use o IP da máquina na rede interna.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080
# Deve ser igual ao TOTEM_API_KEY do servidor.
EXPO_PUBLIC_TOTEM_KEY=exemplo-de-chave-para-totem
# Identificação deste totem (aparece na planilha exportada).
EXPO_PUBLIC_TOTEM_ID=totem-01
# PIN da área técnica (toque longo de 3 s no logotipo da tela inicial).
EXPO_PUBLIC_ADMIN_PIN=exemplo-de-pin-para-area-tecnica
